mainmenu "PredictMotor"

config PM_MOTEUR_AU_DEMARRAGE
    bool "Mettre le ventilateur en marche des le demarrage"
    default n
    help
      Par securite le relais reste ouvert (ventilateur arrete) au
      demarrage. On le met en marche avec la commande "moteur on".

config PM_IMPULSIONS_PAR_TOUR
    int "Impulsions du TCRT5000 par tour d'helice"
    default 1
    help
      Nombre de rubans blancs colles sur le moyeu.

config PM_CT_CHARGE_OHMS
    int "Resistance de charge du TA12-100 (ohms)"
    default 200
    help
      A mesurer au multimetre entre G et S du module, debranche.

config PM_CT_RAPPORT
    int "Rapport du transformateur de courant"
    default 1000
    help
      TA12-100 : 1000 tours au secondaire (1000:1).

config PM_CT_TOURS
    int "Nombre de passages de la phase dans le tore"
    default 10
    help
      Le ventilateur ne tire que 0,14 A : faire passer la phase
      plusieurs fois dans le tore multiplie le signal.

source "Kconfig.zephyr"