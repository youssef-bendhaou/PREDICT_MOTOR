/*
 * Plan de cablage PredictMotor - ESP32 38 broches (esp32_devkitc_wroom)
 * Banc : ventilateur Sunon DP200A 230 V AC commande par relais
 *
 *   ADXL345   : SPI3  SCK=18  MISO=19  MOSI=23  CS=5
 *   DS18B20   : 1-Wire DATA=4 (module avec resistance de tirage)
 *   Relais    : IN=26  (VCC du module sur 3V3, low level trigger)
 *   TCRT5000  : D0=27  (optionnel, vitesse.c continue sans lui)
 *   PZEM-004T : UART2  TX=17 -> RX du PZEM, RX=16 <- TX du PZEM, 9600 8N1
 *
 * Le 230 V ne passe que par les contacts du relais (COM -> NO),
 * par les bornes L/N du PZEM et dans le tore du PZEM (phase seule, 10 tours).
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <dt-bindings/pinctrl/esp32-pinctrl.h>

/ {
    /* Nos propres branchements, lus par moteur.c et vitesse.c */
    zephyr,user {
        /* Module relais "low level trigger" : actif a l'etat bas */
        relais-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
        /* TCRT5000 : D0 passe a 0 quand le ruban blanc passe devant */
        tachy-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
    };

    /* Bus 1-Wire realise par logiciel sur une broche GPIO */
    w1: w1 {
        compatible = "zephyr,w1-gpio";
        gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;

        ds18b20: ds18b20 {
            compatible = "maxim,ds18b20";
            family-code = <0x28>;
            resolution = <12>;          /* 0,0625 degre, conversion 750 ms */
        };
    };
};

/* Accelerometre */
&spi3 {
    status = "okay";

    adxl345: adxl345@0 {
        compatible = "adi,adxl345";
        reg = <0>;
        spi-max-frequency = <5000000>;
        odr = <5>;                /* 400 Hz : doit suivre la cadence de main.c */
    };
};

/* PZEM-004T sur UART2 (Modbus RTU) */
&pinctrl {
    uart2_pzem: uart2_pzem {
        group1 {
            pinmux = <UART2_TX_GPIO17>;
            output-high;
        };
        group2 {
            pinmux = <UART2_RX_GPIO16>;
            bias-pull-up;
        };
    };
};

&uart2 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart2_pzem>;
    pinctrl-names = "default";
};

&wifi {
    status = "okay";
};
