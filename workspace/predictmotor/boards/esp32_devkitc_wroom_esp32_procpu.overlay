/*
 * Plan de cablage PredictMotor - ESP32 DevKit V1
 * Banc : ventilateur Sunon DP200A 230 V AC commande par relais
 *
 *   ADXL345  : SPI3  SCK=18  MISO=19  MOSI=23  CS=5   (inchange)
 *   DS18B20  : 1-Wire DATA=4 (+ 4,7 kohm vers 3V3)    (inchange)
 *   Relais   : IN=26  (VCC du module sur 5V/VIN)
 *   TCRT5000 : D0=27  (1 ruban blanc sur le moyeu = 1 impulsion par tour)
 *   TA12-100 : S=34 (ADC1 canal 6), G = point milieu 1,65 V (2 x 10 kohm + 10 uF)
 *
 * Le 230 V ne passe que par les contacts du relais (COM -> NO)
 * et dans le tore du TA12-100 (phase seule, 10 tours).
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
    /* Nos propres branchements, lus par moteur.c, vitesse.c et capteurs_lents.c */
    zephyr,user {
        /* Module relais declenche a l'etat haut.
         * S'il est marque "low level trigger" : GPIO_ACTIVE_LOW */
        relais-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;        /* TCRT5000 : D0 passe a 0 quand le ruban blanc passe devant */
        tachy-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
        /* TA12-100 : GPIO 34 = ADC1 canal 6 */
        io-channels = <&adc0 6>;
    };

    /* Bus 1-Wire realise par logiciel sur une broche GPIO */
    w1: w1 {
        compatible = "zephyr,w1-gpio";
        gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;

        ds18b20: ds18b20 {
            compatible = "maxim,ds18b20";
            family-code = <0x28>;
            resolution = <12>;          /* 0,0625 degre, conversion 750 ms */
        };
    };
};

/* Accelerometre */
&spi3 {
    status = "okay";

    adxl345: adxl345@0 {
        compatible = "adi,adxl345";
        reg = <0>;
        spi-max-frequency = <5000000>;
        odr = <5>;                /* 400 Hz : doit suivre la cadence de main.c */
    };
};

/* Convertisseur analogique pour le TA12-100 */
&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@6 {
        reg = <6>;
        zephyr,gain = "ADC_GAIN_1_4";   /* attenuation 11 dB : 0 a ~3,1 V */
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};
